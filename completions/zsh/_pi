#compdef pi private-index private-index-cli

_pi() {
    local -a commands
    commands=(
        'index:Index documents in the specified directory'
        'watch:Run background watcher daemon for live folder monitoring'
        'search:Run semantic similarity search for a query'
        'bench:Run on-device Apple Silicon performance benchmark'
        'stats:Show database stats and indexed document counts'
        'reset:Clear database and purge all vector embeddings'
        'help:Display this help message'
    )

    _arguments -C \
        '(-h --help)'{-h,--help}'[Display this help message]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'pi command' commands
            ;;
        args)
            case $words[1] in
                index)
                    _arguments '1:directory:_directories'
                    ;;
                watch)
                    _arguments \
                        '--install-launchagent[Install and load launchd LaunchAgent for 24/7 background operation]' \
                        '1:directory:_directories'
                    ;;
                search)
                    _arguments \
                        '--mode[Search mode (hybrid, vector, keyword)]:mode:(hybrid vector keyword)' \
                        '--limit[Maximum number of results to return]:limit:' \
                        '--vector-weight[Vector weight for hybrid search]:weight:' \
                        '--keyword-weight[Keyword weight for hybrid search]:weight:' \
                        '*:query:'
                    ;;
                bench)
                    _arguments \
                        '--vectors[Number of synthetic vectors to evaluate]:vectors:' \
                        '--json[Output metrics as machine-readable JSON]'
                    ;;
            esac
            ;;
    esac
}

_pi "$@"
